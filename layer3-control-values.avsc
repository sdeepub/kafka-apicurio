# Base control schema (applies to all machines)
{
  "name": "MachineControl",
  "type": "record",
  "fields": [
    # MACHINE IDENTIFICATION (partition key)
    {"name": "machine_id", "type": "string"},
    {"name": "machine_type", "type": "MachineType"},  # Links to toolset schema
    {"name": "facility_id", "type": "string"},
    
    # VERSIONING & GOVERNANCE
    {"name": "config_version", "type": "int"},
    {"name": "config_hash", "type": "string"},
    {"name": "approval_id", "type": "string"},
    {"name": "approver", "type": "string"},
    {"name": "change_reason", "type": "string"},
    {"name": "effective_from", "type": "long", "logicalType": "timestamp-millis"},
    
    # TOOLSET-SPECIFIC THRESHOLDS (union by machine_type)
    {
      "name": "thresholds",
      "type": [
        "null",
        "LatheThresholds",
        "MillThresholds",
        "PressThresholds",
        "OvenThresholds",
        "CNCThresholds"
      ]
    }
  ]
}

# LATHE-SPECIFIC THRESHOLDS
Subject: lathe-thresholds (Avro)
{
  "type": "record",
  "name": "LatheThresholds",
  "fields": [
    {"name": "max_spindle_rpm", "type": "float", "default": 5000.0},
    {"name": "max_spindle_temp", "type": "float", "default": 85.0, "doc": "°C"},
    {"name": "max_cutting_force", "type": "float", "default": 15000.0, "doc": "N"},
    {"name": "min_tool_life", "type": "float", "default": 0.5, "doc": "hours before change"},
    {"name": "max_coolant_pressure", "type": "float", "default": 12.0, "doc": "bar"},
    {"name": "alert_spindle_temp", "type": "float", "default": 75.0, "doc": "Warning threshold"}
  ]
}

# MILL-SPECIFIC THRESHOLDS
Subject: mill-thresholds (Avro)
{
  "type": "record",
  "name": "MillThresholds",
  "fields": [
    {"name": "max_spindle_rpm", "type": "float", "default": 8000.0},
    {"name": "max_spindle_temp", "type": "float", "default": 90.0},
    {"name": "max_table_speed_x", "type": "float", "default": 500.0, "doc": "mm/min"},
    {"name": "max_table_speed_y", "type": "float", "default": 500.0},
    {"name": "max_table_speed_z", "type": "float", "default": 300.0},
    {"name": "max_vibration", "type": "float", "default": 5.0, "doc": "mm/s"},
    {"name": "alert_vibration", "type": "float", "default": 3.0}
  ]
}

# PRESS-SPECIFIC THRESHOLDS
Subject: press-thresholds (Avro)
{
  "type": "record",
  "name": "PressThresholds",
  "fields": [
    {"name": "max_pressure", "type": "float", "default": 250.0, "doc": "bar"},
    {"name": "min_pressure_setpoint", "type": "float", "default": 100.0},
    {"name": "max_cycle_time", "type": "float", "default": 30.0, "doc": "seconds"},
    {"name": "max_die_temp", "type": "float", "default": 120.0, "doc": "°C"},
    {"name": "alert_die_temp", "type": "float", "default": 100.0},
    {"name": "max_cycles_per_hour", "type": "int", "default": 120}
  ]
}

# OVEN-SPECIFIC THRESHOLDS
Subject: oven-thresholds (Avro)
{
  "type": "record",
  "name": "OvenThresholds",
  "fields": [
    {"name": "target_temp", "type": "float", "default": 200.0, "doc": "°C"},
    {"name": "temp_tolerance", "type": "float", "default": 5.0, "doc": "±°C"},
    {"name": "max_humidity", "type": "float", "default": 60.0, "doc": "%"},
    {"name": "min_humidity", "type": "float", "default": 20.0},
    {"name": "min_airflow", "type": "float", "default": 50.0, "doc": "m³/h"},
    {"name": "max_temp", "type": "float", "default": 250.0, "doc": "Safety hard limit"}
  ]
}

# CNC-SPECIFIC THRESHOLDS
Subject: cnc-thresholds (Avro)
{
  "type": "record",
  "name": "CNCThresholds",
  "fields": [
    {"name": "max_spindle_rpm", "type": "float", "default": 10000.0},
    {"name": "max_spindle_temp", "type": "float", "default": 95.0},
    {"name": "position_tolerance", "type": "float", "default": 0.1, "doc": "mm"},
    {"name": "alert_position_drift", "type": "float", "default": 0.05},
    {"name": "max_program_duration", "type": "long", "default": 3600, "doc": "seconds"}
  ]
}