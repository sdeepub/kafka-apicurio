{
  "type": "record",
  "name": "MachineTelemetry",
  "namespace": "local.home.arpa.telemetry",
  "fields": [
    { "name": "device_id", "type": "string" },
    { "name": "timestamp", "type": "long" },
    { "name": "vibration", "type": "double" },
    { "name": "temperature", "type": "double" },
    { "name": "pressure", "type": "double" },
    { "name": "status", "type": "string" },
    { "name": "track_in", "type": ["null", "long"], "default": null },
    { "name": "track_out", "type": ["null", "long"], "default": null },
    { "name": "run_num", "type": "int" },
    { "name": "part_id", "type": "string" }
  ]
}
